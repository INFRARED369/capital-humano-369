# =====================================================================
# 369 Capital Humano · variables de entorno (SIN valores reales).
# Fuente: src/CONTRATOS.md §"Configuración de entorno" y apps/web/lib/config.ts.
# Rotación y custodia: docs/runbook.md. Validación al arrancar: supabase/functions/_shared/env.ts.
#
#  - Bloque A (NEXT_PUBLIC_*): se incrustan en el HTML/JS en build. SOLO valores públicos.
#    En CI son "Variables" del repositorio (vars.*), no "Secrets".
#  - Bloque B: SOLO edge functions (Supabase → Project Settings → Edge Functions → Secrets,
#    o `supabase secrets set --env-file supabase/functions/.env`). Jamás en el frontend:
#    scripts/scan-secrets.mjs bloquea el deploy si aparecen en apps/web/out (NFR-SEG-02).
#  - Bloque C: solo GitHub Actions (Settings → Environments → produccion → Secrets).
# =====================================================================

# ---------- A. Frontend (públicas, build de Next.js) ----------
NEXT_PUBLIC_SUPABASE_URL=https://...
# Anon / publishable key: pública por diseño (RLS deny-by-default). NUNCA la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FUNCIONES_URL=https://...
# Site key de Turnstile (pública). Pruebas: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_WHATSAPP_FALLBACK=52XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX
NEXT_PUBLIC_VERSION_AVISO=2026-11-13

# ---------- B. Edge functions (secretos) ----------
# Supabase inyecta SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY y SUPABASE_DB_URL
# automáticamente en producción; localmente los da `supabase start`.
# Pooler en modo transacción (puerto 6543) → el cliente usa prepare:false.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Pepper de HMAC para deduplicación, opt-out y llaves de rate limit (≥ 32 bytes aleatorios, base64).
HMAC_PEPPER=
# Clave AES-GCM de 256 bits en base64 para cifrar el OTP en la cola (openssl rand -base64 32).
OTP_ENC_KEY=
# Secreto HMAC de links firmados de cancelar/reprogramar (≥ 32 bytes).
LINKS_SECRET=
# Secret key de Turnstile. Pruebas: 1x0000000000000000000000000000000AA (siempre pasa).
TURNSTILE_SECRET=
# Solo pruebas locales (mock): http://host.docker.internal:<puerto>/siteverify. En producción déjalo vacío.
TURNSTILE_URL=

# Evolution API (WhatsApp)
EVOLUTION_URL=https://evolution.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Token del webhook (≥ 16, recomendado 32+ aleatorio: openssl rand -hex 32). Evolution v2 no firma con HMAC:
# se configura como cabecera `x-369-webhook-token` en `webhook.headers` de la instancia (runbook §10).
EVOLUTION_WEBHOOK_SECRET=
# Opcional: desfase UTC (minutos) con el que Evolution escribe `date_time` (hora local con sufijo Z).
# 0 si el contenedor de Evolution corre con TZ=UTC (recomendado); America/Mexico_City = -360.
EVOLUTION_WEBHOOK_TZ_OFFSET_MIN=0


# Correo (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=XXXXXXXXXX
SMTP_FROM=

# SMS (NBX, SMS nacional): POST {NBX_API_URL}/v2/sms/send con Authorization: Basic <NBX_API_KEY>.
# NBX_API_URL = base https de la API (o la URL completa terminada en /v2/sms/send).
#   NBX bloquea por IP y Supabase no tiene IP de salida fija: usar el relay de n8n (infra/n8n/nbx-sms-relay.json),
#   NBX_API_URL=https://<n8n>/webhook/nbx/v2/sms/send
# NBX_SENDER = shortcode o máscara (opcional; vacío = default de la cuenta).
# NBX_MAX_CHARS = solo si NBX habilitó SMS de más de 160 caracteres.
NBX_API_URL=
NBX_API_KEY=
NBX_SENDER=
NBX_MAX_CHARS=
NBX_WEBHOOK_SECRET=

# Canales para el código de verificación (postular / verificar-otp). Vacío = whatsapp,sms,email.
# Mientras NBX no esté configurado conviene: CANALES_OTP=whatsapp,email
CANALES_OTP=

# Zoho Calendar (Enterprise) — cuenta de servicio, scope ZohoCalendar.event.ALL únicamente (NFR-SEG-06)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data center: com | eu | in | com.au | jp | ca (Q-2)
ZOHO_DC=com

# Tracking server-side (un solo Pixel, D10)
META_PIXEL_ID=
META_CAPI_TOKEN=
STAPE_URL=https://<container>.stape.io
GA4_API_SECRET=
GA4_MEASUREMENT_ID=
# Opcionales de tracking: código de prueba de Meta y envío de Lead a CAPI sin cookies (requiere aprobación legal, Q-3)
META_TEST_EVENT_CODE=
TRACKING_CAPI_SIN_COOKIES=false
TRACKING_WORKER_SECRET=
# TRK-07 · Lugar de acceso por IP (opcional). Orden: headers del CDN en la ingesta → este proveedor (asíncrono, en
# tracking-capi-worker, solo eventos sin dato del CDN) → nada. Plantilla https con {ip}; se envía la red /24 (o /48),
# nunca la IP completa, y solo se guarda ciudad/región/país. Ej.: https://ipapi.co/{ip}/json/ · https://ipinfo.io/{ip}/json?token=<token>
GEOIP_URL=
GEOIP_TIMEOUT_MS=1500
# Rate limit de tracking-ingest: eventos por minuto por /24 sumando todos los isolates (contador en BD por lotes).
TRACKING_RATE_LIMIT_GLOBAL=600

# Comunicación: secreto del cron del worker (si no, usa SUPABASE_SERVICE_ROLE_KEY) y costos por mensaje en MXN
COMUNICACION_WORKER_SECRET=
COSTO_WHATSAPP_MXN=0.0
COSTO_EMAIL_MXN=0.0
COSTO_SMS_MXN=0.3

# Alertas (NFR-OBS-01, cron cada 5 min). Sin canal, las alertas quedan en shared.alertas y en los logs.
# Webhook entrante https (Slack: https://hooks.slack.com/services/…; Discord: https://discord.com/api/webhooks/…). Payload sin PII.
ALERTAS_WEBHOOK_URL=
# Correos separados por coma (usa SMTP_* de arriba).
ALERTAS_EMAIL= 
# Etiqueta en el asunto (produccion, staging) y secreto del cron (si no, SUPABASE_SERVICE_ROLE_KEY).
ALERTAS_ENTORNO=produccion
ALERTAS_SECRET=
# Umbrales opcionales (JSON): {"cola_atascada_min":5,"otp_ventana_min":60,"otp_umbral":0.15,"otp_min_muestra":10,"retencion_horas":26}
ALERTAS_CONFIG={"cola_atascada_min":5,"otp_ventana_min":60,"otp_umbral":0.10,"otp_min_muestra":10,"retencion_horas":26}

# Privacidad: arco verifica el JWT contra /auth/v1/user con la anon key; MFA obligatorio para admin.
SUPABASE_ANON_KEY=
RETENCION_SECRET=
ARCO_REQUIERE_MFA=true
# Días inhábiles extra (YYYY-MM-DD separados por coma) para el plazo ARCO de 20 días hábiles.
ARCO_DIAS_INHABILES=

# CORS y links
# Uno o varios orígenes separados por coma (sin barra final).
ALLOWED_ORIGIN=https://369capitalhumano.com,https://www.369capitalhumano.com
# Origen del sitio (sin /panel): el evento de Zoho enlaza a ${PANEL_URL}/panel/citas/?id=<cita>
PANEL_URL=https://369capitalhumano.com

# ---------- C. CI/CD (GitHub Actions, environment "produccion") ----------
# Deploy de estáticos por SSH (rsync --delete de apps/web/out)
SSH_PRIVATE_KEY=
SSH_KNOWN_HOSTS=
SSH_HOST=
SSH_USER=
SSH_PORT=22
DEPLOY_PATH=/var/www/369capitalhumano/
# Deploy de migraciones y edge functions (opcional: si faltan, el job se omite)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# No funcionales / E2E-14 contra staging
STAGING_URL=https://staging.369capitalhumano.com
STAGING_FUNCIONES_URL=https://<staging-ref>.supabase.co/functions/v1
K6_VACANTE_SLUG=agente-smart
